# ====== Electricalskart Help Desk ======
# Copy this file to .env and fill in values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Auth secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=72

# Owner bootstrap account (created on first run if no users exist)
OWNER_NAME=Owner
OWNER_EMAIL=owner@electricalskart.local
OWNER_PASSWORD=ChangeThisPassword!

# AI Provider (OpenAI-compatible). Leave blank to use a local/rule-based fallback.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_SYSTEM_PROMPT=You are the helpful support assistant for Electricalskart, an Indian electricals/appliances retailer. Answer using known product/business facts only. If you are uncertain, missing information, or the customer needs something specific (price quote, order status, complaint, service booking, custom request), SAY SO clearly and respond with the exact token [[HUMAN_REQUIRED]] on its own line so the system can escalate to a human agent. Never invent prices, specifications, availability or policies. Be concise, polite and helpful.

# SQLite DB file
DB_FILE=./data/helpdesk.sqlite

# CORS origin (for dev)
CORS_ORIGIN=http://localhost:5173
