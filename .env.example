# ====== Electricalskart Help Desk ======
# Copy this file to .env and fill in values. Never commit .env.

# Server
PORT=3001
NODE_ENV=development

# Required: generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
SESSION_TTL_HOURS=12

# Required only when bootstrapping an empty database. No defaults are used.
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# AI provider is optional. Customer facts always come from verified knowledge.
# Supported: local, openai-compatible ("openai" is accepted as an alias).
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000
AI_SYSTEM_PROMPT=

# Optional JSON file containing owner-verified business knowledge entries.
BUSINESS_KNOWLEDGE_FILE=

# WebRTC ICE. STUN defaults are used when STUN_URLS is blank.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Configure all three TURN values for reliable calls across restrictive NAT/firewalls.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Call timing
CALL_RING_TIMEOUT_MS=30000
CALL_QUEUE_TTL_MS=900000

# SQLite DB file
DB_FILE=./data/helpdesk.sqlite

# Comma-separated cross-origin clients. Leave blank in same-origin production.
CORS_ORIGIN=http://localhost:5173
